# Copy this file to .env (project root) and fill in your own keys. Never commit .env.
GNANI_API_KEY=
GNANI_API_BASE=https://api.vachana.ai
# groq (default) | gemini | none
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_BACKUP=0
# STT_CONTEXT=1
# DATABASE_URL=
# CORS_ORIGINS=http://localhost:3000
# PUBLIC_BASE_URL=http://localhost:3000
# web/: BACKEND_URL=http://127.0.0.1:8000 (where Next proxies /api/*)
