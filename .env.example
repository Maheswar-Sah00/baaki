# Copy this file to .env (project root) and fill in your own keys. Never commit .env.
# Real environment variables (Render, Fly, docker run -e) win over .env. Unset = the default shown.
# Comments sit on their own lines so a pasted key never picks up trailing text.

# ---------------------------------------------------------------- keys (secrets)
# Gnani: Prisma STT, Timbre TTS, Voice Clone
GNANI_API_KEY=
GNANI_API_BASE=https://api.vachana.ai
# groq (default) | gemini (Gemini first) | none (LLM off; templates only). The LLM never makes rupee figures.
LLM_PROVIDER=groq
GROQ_API_KEY=
# Optional backup LLM, used only with GEMINI_BACKUP=1 or LLM_PROVIDER=gemini
GEMINI_API_KEY=

# ---------------------------------------------------------------- LLM and STT tuning (optional)
# GROQ_MODEL=openai/gpt-oss-20b         strict JSON-schema model
# GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_BACKUP=0                       1 = try Gemini when Groq fails
# STT_CONTEXT=1                         0 = don't send the topic + key terms with Prisma requests
# STT_MAX_SECONDS=90                    longest recording sent to STT, in seconds (localhost too)

# ---------------------------------------------------------------- storage
# DATABASE_URL=                         unset = SQLite at backend/data/app.db. Deploy: sqlite:////data/app.db
#                                       (4 slashes = absolute path). Postgres is NOT supported as shipped:
#                                       no driver (psycopg) is in backend/requirements.txt.
# MEDIA_DIR=                            voice notes, PDFs, uploads (default backend/data/media)
# TTS_CACHE_DIR=                        Timbre disk cache (default backend/data/tts_cache). backend/seed_cache/tts
#                                       is always read after it, so the demo clips play on a cold start.
# AUDIO_TMP_DIR=                        ffmpeg scratch files (default backend/data/tmp)

# ---------------------------------------------------------------- links and CORS
# PUBLIC_BASE_URL=http://localhost:3000 origin used in the links Baaki writes (letters, share text). With
#                                       TRUSTED_PROXY=1 it is taken per request from the proxy's host header.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
#                                       only for direct browser calls to the API; the web app proxies /api/*
#                                       on its own origin.

# ---------------------------------------------------------------- public deploy (all off on localhost)
# BAAKI_PUBLIC=0                        1 = public mode: worker keys, admin token on demo resets, Gnani budget,
#                                       cache-only TTS outside TTS_LIVE_ROUTES, no cloning without spoken consent
# BAAKI_ADMIN_TOKEN=                    secret; sent as the X-Admin-Token header to POST /api/demo/reset in public mode
# BAAKI_DEMO_OPEN=1                     public mode: the seeded synthetic workers (no key) stay viewable
# TRUSTED_PROXY=                        1 = read the visitor IP from proxy headers (cf-connecting-ip, else the
#                                       X-Forwarded-For hop the proxy added); 0 = socket peer only.
#                                       Unset: old behaviour on localhost, 0 in public mode.
# TRUSTED_PROXY_HOPS=1                  X-Forwarded-For entries added by trusted proxies
# GNANI_BUDGET_STT=400                  public mode: Prisma calls per IST day, all visitors
# GNANI_BUDGET_TTS=150                  public mode: new Timbre clips per IST day (cache hits are free)
# GNANI_BUDGET_VC=0                     public mode: voice-clone calls per IST day
# GNANI_BUDGET_PER_IP=40                public mode: Gnani calls one visitor IP may cause per IST day
# GNANI_DEADLINE_S=45                   total time one Gnani call may take, queueing for the 1-request lock included
# GNANI_BREAKER_S=300                   after a 401/402 from Gnani, fail fast for this many seconds
# TTS_LIVE_ROUTES=                      public mode: comma-separated route templates allowed to make NEW Timbre
#                                       audio ("*" = all). Default: employer reply, read-back, messages, inbox.
# ONBOARD_PER_IP_DAY=5                  public mode: new workers one IP may create per day
# CHECK_STT_PER_IP_DAY=3                Fair Pay Check mic: uses per visitor IP per IST day
# CHECK_STT_GLOBAL_DAY=150              Fair Pay Check mic: uses per IST day in total

# ---------------------------------------------------------------- demo data
# Startup seeds the synthetic demo story when the database has no workers, only if BOTH switches are on:
# SEED_ON_BOOT=                         read by main.py (config.seed_on_boot); default on in public mode, off locally
# BAAKI_SEED_ON_BOOT=1                  read by seed.ensure_seeded(); 0 turns seeding off everywhere
# BAAKI_TODAY=                          YYYY-MM-DD: pin "today" for the demo story and due dates (unset = real date)

# ---------------------------------------------------------------- web app (web/; read at `next build`)
# BACKEND_URL=http://127.0.0.1:8000     where Next proxies /api/* (baked into the build)
# NEXT_PUBLIC_SITE_URL=http://localhost:3020
#                                       public origin for link previews (Open Graph)
# NEXT_PUBLIC_BAAKI_INTERIM_MS=4500     meter interim update every N ms while she talks (min 2500; 0 = only after
#                                       she stops). Each update is 1 STT call.
# NEXT_DIST_DIR=.next                   build folder (the demo runner uses .next-demo)
# EXTRA_DEV_ORIGINS=                    extra hostnames allowed to load `next dev` assets (comma-separated)

# ---------------------------------------------------------------- scripts
# BAAKI_RETEST_DIR=                     retest_features.py scratch folder (default <system temp>/baaki-retest)
# BAAKI_URL=http://localhost:3013       web/scripts/make-og.mjs: the page it screenshots for the preview image
# API_URL= FAKE_AUDIO= UI_LANG=         web/scripts/shots.cjs (screenshot tool): API to proxy, stub employer audio,
#                                       UI language to force
